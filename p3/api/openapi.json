          "total_orders",
          "net_revenue_usd",
          "gross_revenue_usd",
          "total_units_sold",
          "average_ticket_usd",
          "total_estimated_margin_usd",
          "estimated_margin_pct",
          "on_time_delivery_rate_pct",
          "cancellation_return_rate_pct"
        ],
        "title": "SummaryKPIs"
      },
      "TrendPoint": {
        "properties": {
          "period": {
            "type": "string",
            "title": "Period",
            "description": "Periodo en formato YYYY-MM o YYYY"
          },
          "total_orders": {
            "type": "integer",
            "title": "Total Orders"
          },
          "net_revenue_usd": {
            "type": "number",
            "title": "Net Revenue Usd"
          },
          "average_ticket_usd": {
            "type": "number",
            "title": "Average Ticket Usd"
          }
        },
        "type": "object",
        "required": [
          "period",
          "total_orders",
          "net_revenue_usd",
          "average_ticket_usd"
        ],
        "title": "TrendPoint"
      },
      "TrendResponse": {
        "properties": {
          "source_system": {
